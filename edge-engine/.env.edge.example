# Template para .env.edge (DEC-REF-68 pata a — env fuente única del edge).
# Copiar como `edge-engine/.env.edge` y completar con valores reales (git-ignored).
# El archivo real NUNCA se commitea (patrón .env.* del .gitignore raíz).
#
# Topología de PRODUCCIÓN (docker_compose_production.yml, DEC-REF-68 pata b):
# el edge corre como servicio `wanomi-edge` en la red default del compose y
# resuelve a sus vecinos por hostname de servicio — mongo/emqx, NO localhost.

# Mongo — hostname `mongo` (contenedor), DB `iotix`, auth admin.
MONGODB_URI=mongodb://<mongo_username>:<mongo_password>@mongo:27017/iotix?authSource=admin

# Site owner (uno por edge; el pack cummins-pcc-v1 es global por deviceType).
SITE_ID=CR00061

# EMQX — hostname `emqx` (contenedor), TCP 1883.
MQTT_HOST=mqtt://emqx:1883

# Credenciales MQTT — superuser EMQX (mismas que usa el servicio `node`).
# EMQX_ALLOW_ANONYMOUS=false + EMQX_NOMATCH=deny exigen auth explícita.
MQTT_USER=<emqx_superuser>
MQTT_PASS=<emqx_superuser_password>

# Canal Telegram (DEC-REF-67 — retry acotado 3× / 2·4·8s + jitter).
# Bot creado con @BotFather. Chat ID = destino default de las notifs.
TELEGRAM_BOT_TOKEN=<bot_token_from_botfather>
TELEGRAM_CHAT_ID_DEFAULT=<default_chat_id>
