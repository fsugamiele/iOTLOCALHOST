# DEC-REF-134 — env del worker wanomi-qa (Supervisor de Calidad).
# Copiar a qa/.env.qa y completar (el real queda gitignored por .env.*).
# El QA es READ-ONLY sobre Mongo: solo necesita la URI y el site. NO usa MQTT ni Telegram.

# Conexión a Mongo (misma base `iotix` que lee el motor). Mismo valor que edge-engine/.env.edge.
MONGODB_URI=mongodb://<user>:<pass>@mongo:27017/iotix?authSource=admin
SITE_ID=CR00061

# Interruptor del worker: 'true' agenda las capas; cualquier otra cosa = idle (solo /health).
QA_ENABLED=true
# http interno (NO se publica al host; node lo consume por la red docker en el bloque 136).
QA_HTTP_PORT=3010
# Capa B (invariantes runtime): cada cuántos ms. 300000 = 5 min.
QA_CAPA_B_INTERVAL_MS=300000
# Capa C (oráculo nocturno): hora local de disparo (0-23).
QA_CAPA_C_HOUR=3
