[Unit]
# DEC-REF-108 (#80) — autostart del supervisor del simulador al boot del host.
# Cierra el incidente del 22/09: el supervisor cubría la muerte del proceso
# pero nadie lo relanzaba tras un reinicio del servidor (2 días de sim con
# templates viejos / sin supervisión).
Description=Wanomi device simulator supervisor (supervisor.sh)
After=docker.service
Wants=docker.service

[Service]
Type=simple
WorkingDirectory=/root/IotLocalhost
ExecStart=/bin/bash /root/IotLocalhost/tools/device_simulator/supervisor.sh
Restart=always
RestartSec=10
StandardOutput=append:/root/IotLocalhost/logs/sim-CR00061.log
StandardError=append:/root/IotLocalhost/logs/sim-CR00061.log

[Install]
WantedBy=multi-user.target
